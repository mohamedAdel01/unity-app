{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [".output/**"]
    },
    "build:mobile": {
      "outputs": [".output/**"]
    },
    "generate": {
      "dependsOn": ["build"],
      "outputs": [".output/public/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "cache": true
    }
  }
}