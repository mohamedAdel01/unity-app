{
  "name": "unity-client-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @unity/mob-app dev",
    "build:mobile": "turbo run build --filter=@unity/mob-app && turbo run generate --filter=@unity/mob-app && pnpm cap copy && pnpm cap sync && pnpm cap run android",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "cypress:run": "cypress run --headless",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/toast": "^8.0.1",
    "cypress": "^16.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.28.0"
}
