{
  "name": "unity-client-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @unity/mob-app dev",
    "build:mobile": "turbo run build --filter=@unity/mob-app && turbo run generate --filter=@unity/mob-app && pnpm cap copy && pnpm cap sync && pnpm cap run android",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "cypress:run": "cypress run --headless",
    "cypress:open": "cypress open"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/toast": "^8.0.1",
    "@pinia/nuxt": "^0.9.0",
    "libphonenumber-js": "^1.13.15",
    "nuxt": "^3.15.2",
    "ofetch": "^1.4.1",
    "pinia": "^2.3.1",
    "primeicons": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "cypress": "^16.2.1",
    "sass": "^1.83.4",
    "sharp": "^0.35.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.28.0"
}
